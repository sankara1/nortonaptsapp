<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Norton Apartments"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Maintenance Manager"
            android:textColor="#64748B"
            android:layout_marginBottom="24dp"/>

        <!-- PAYMENT SECTION -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="2dp"
            android:layout_margin="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Record Payment"
                    android:textStyle="bold"
                    android:textColor="#4F46E5"
                    android:layout_marginBottom="12dp"/>

                <Spinner
                    android:id="@+id/flatSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp"/>

                <Spinner
                    android:id="@+id/monthSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp"/>

                <Spinner
                    android:id="@+id/paymentTypeSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/payAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Amount (e.g. 2000)"
                    android:inputType="number"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/phoneInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="WhatsApp Phone Number"
                    android:inputType="phone"
                    android:layout_marginBottom="12dp"/>

                <Button
                    android:id="@+id/btnSavePayment"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="Save &amp; Send WhatsApp"
                    android:backgroundTint="#10B981"
                    android:layout_marginBottom="8dp"/>

                <Button
                    android:id="@+id/btnMultiplePayments"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Record Multiple Payments"
                    android:backgroundTint="#059669"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- EXPENSE SECTION -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="2dp"
            android:layout_margin="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Register Expense"
                    android:textStyle="bold"
                    android:textColor="#E11D48"
                    android:layout_marginBottom="12dp"/>

                <Spinner
                    android:id="@+id/expenseTypeSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp"/>

                <Spinner
                    android:id="@+id/expensePaymentTypeSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/expenseAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Amount (e.g. 8000)"
                    android:inputType="number"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/expenseDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Date of Expense"
                    android:focusable="false"
                    android:clickable="true"
                    android:layout_marginBottom="12dp"/>

                <Button
                    android:id="@+id/btnSaveExpense"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="Record Expenditure"
                    android:backgroundTint="#EF4444"
                    android:layout_marginBottom="8dp"/>

                <Button
                    android:id="@+id/btnViewExpenses"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="View All Expenses"
                    android:backgroundTint="#F87171"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- SETTINGS / SIGNATURE SECTION -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="2dp"
            android:layout_margin="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reports &amp; Settings"
                    android:textStyle="bold"
                    android:textColor="#475569"
                    android:layout_marginBottom="12dp"/>

                <EditText
                    android:id="@+id/signatureInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Your Signature (for PDF)"
                    android:text="S.Sankarasubramanian"
                    android:layout_marginBottom="12dp"/>

                <Button
                    android:id="@+id/btnExportData"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Export Monthly CSV to WhatsApp"
                    android:backgroundTint="#334155"
                    android:layout_marginBottom="8dp"/>

                <Button
                    android:id="@+id/btnViewStatus"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Check Payment Status (Who Paid?)"
                    android:backgroundTint="#334155"
                    android:layout_marginBottom="8dp"/>

                <Button
                    android:id="@+id/btnShareSummary"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Send Summary to Admin WhatsApp"
                    android:backgroundTint="#0ea5e9"
                    android:layout_marginBottom="8dp"/>

                <Button
                    android:id="@+id/btnParameters"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="App Parameters"
                    android:backgroundTint="#64748B"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>