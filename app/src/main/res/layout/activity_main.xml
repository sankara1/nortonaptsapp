<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/buildingNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Norton Apartments"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:layout_marginBottom="2dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Maintenance Manager"
            android:textColor="#64748B"
            android:textSize="14sp"
            android:layout_marginBottom="16dp"/>

        <!-- ========================================== -->
        <!-- PAYMENT SECTION                            -->
        <!-- ========================================== -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:elevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Record Payment"
                    android:textStyle="bold"
                    android:textColor="#4F46E5"
                    android:layout_marginBottom="10dp"/>

                <!-- Row 1: Flat & Month Dropdowns -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:layout_marginBottom="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Flat" android:textSize="12sp" android:textColor="#64748B" />
                        <Spinner
                            android:id="@+id/flatSpinner"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@android:drawable/btn_dropdown"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Month" android:textSize="12sp" android:textColor="#64748B" />
                        <Spinner
                            android:id="@+id/monthSpinner"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@android:drawable/btn_dropdown"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 2: Payment Method Radio Group -->
                <RadioGroup
                    android:id="@+id/paymentTypeRadioGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <RadioButton
                        android:id="@+id/radioPayCash"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cash"
                        android:textSize="14sp"
                        android:checked="true"/>
                    <RadioButton
                        android:id="@+id/radioPayGpay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gpay"
                        android:textSize="14sp"
                        android:layout_marginStart="16dp"/>
                </RadioGroup>

                <!-- Row 3: Amount & Phone Inputs -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:layout_marginBottom="12dp">

                    <EditText
                        android:id="@+id/payAmount"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:hint="Amt (e.g. 2000)"
                        android:inputType="number"
                        android:textSize="14sp"/>

                    <EditText
                        android:id="@+id/phoneInput"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:hint="WhatsApp No."
                        android:inputType="phone"
                        android:textSize="14sp"/>
                </LinearLayout>

                <!-- Row 4: Action Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <Button
                        android:id="@+id/btnSavePayment"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="Save &amp; Send"
                        android:backgroundTint="#10B981"
                        android:textSize="12sp"
                        android:padding="0dp"/>

                    <Button
                        android:id="@+id/btnMultiplePayments"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="Multiple Pymts"
                        android:backgroundTint="#059669"
                        android:textSize="12sp"
                        android:padding="0dp"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ========================================== -->
        <!-- EXPENSE SECTION                            -->
        <!-- ========================================== -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:elevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Register Expense"
                    android:textStyle="bold"
                    android:textColor="#E11D48"
                    android:layout_marginBottom="10dp"/>

                <!-- Expense Type -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Expense Category" android:textSize="12sp" android:textColor="#64748B" />
                    <Spinner
                        android:id="@+id/expenseTypeSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@android:drawable/btn_dropdown"/>
                </LinearLayout>

                <!-- Payment Method -->
                <RadioGroup
                    android:id="@+id/expensePaymentTypeRadioGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <RadioButton
                        android:id="@+id/radioExpCash"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cash"
                        android:textSize="14sp"
                        android:checked="true"/>
                    <RadioButton
                        android:id="@+id/radioExpGpay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gpay"
                        android:textSize="14sp"
                        android:layout_marginStart="16dp"/>
                </RadioGroup>

                <!-- Row: Amount & Date Inputs -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:layout_marginBottom="12dp">

                    <EditText
                        android:id="@+id/expenseAmount"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:hint="Amt (e.g. 8000)"
                        android:inputType="number"
                        android:textSize="14sp"/>

                    <EditText
                        android:id="@+id/expenseDate"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:hint="Date"
                        android:focusable="false"
                        android:clickable="true"
                        android:textSize="14sp"/>
                </LinearLayout>

                <!-- Row: Action Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <Button
                        android:id="@+id/btnSaveExpense"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="Record Expense"
                        android:backgroundTint="#EF4444"
                        android:textSize="12sp"
                        android:padding="0dp"/>

                    <Button
                        android:id="@+id/btnViewExpenses"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="View All"
                        android:backgroundTint="#F87171"
                        android:textSize="12sp"
                        android:padding="0dp"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ========================================== -->
        <!-- SETTINGS / REPORTS SECTION (GRID LAYOUT)   -->
        <!-- ========================================== -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reports &amp; Settings"
                    android:textStyle="bold"
                    android:textColor="#475569"
                    android:layout_marginBottom="10dp"/>

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:useDefaultMargins="true"
                    android:alignmentMode="alignBounds">

                    <Button
                        android:id="@+id/btnExportData"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_columnWeight="1"
                        android:text="Export CSV"
                        android:backgroundTint="#334155"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnViewStatus"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_columnWeight="1"
                        android:text="Who Paid?"
                        android:backgroundTint="#334155"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnSetOpeningBalance"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_columnWeight="1"
                        android:text="Set Balance"
                        android:backgroundTint="#6366f1"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnShareSummary"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_columnWeight="1"
                        android:text="Share Summary"
                        android:backgroundTint="#0ea5e9"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnParameters"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_columnWeight="1"
                        android:text="App Params"
                        android:backgroundTint="#64748B"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnImportCsv"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_columnWeight="1"
                        android:text="Import CSV"
                        android:backgroundTint="#475569"
                        android:textSize="11sp" />

                </GridLayout>

                <!-- Kept Get Template full width at bottom as a utility -->
                <Button
                    android:id="@+id/btnGetCsvTemplate"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Get CSV Template"
                    android:backgroundTint="#94A3B8"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>